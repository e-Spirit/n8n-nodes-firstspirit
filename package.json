{
	"name": "n8n-nodes-firstspirit",
	"version": "0.0.25-beta.0",
	"description": "n8n integration for the FirstSpirit REST API",
	"keywords": [
		"n8n",
		"n8n-nodes",
		"firstspirit",
		"n8n-community-node-package"
	],
	"license": "MIT",
	"homepage": "https://github.com/e-Spirit/n8n-nodes-firstspirit#readme",
	"author": {
		"name": "Donato Marro",
		"email": "donato.marro@rezolve.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e-Spirit/n8n-nodes-firstspirit.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "dist/index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"test": "jest",
		"format": "prettier --write .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FirstSpiritApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FirstSpiritRestApi/FirstSpiritRestApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.5",
		"@types/jest": "^30.0.0",
		"eslint": "^9.29.0",
		"jest": "^30.1.3",
		"n8n-workflow": "^1.83.0",
		"prettier": "^3.5.3",
		"release-it": "^20.2.1",
		"ts-jest": "^29.4.3",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
