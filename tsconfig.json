{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "node",
		"outDir": "./dist",
		"rootDir": "./",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"lib": ["ES2020"]
	},
	"include": ["index.ts", "nodes/**/*.ts", "credentials/**/*.ts", "package.json"],
	"exclude": ["node_modules", "dist", "tests"]
}
